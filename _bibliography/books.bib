  bibtex_show = {true},
  author =    {Illimoottil, M. and Kunz, A. and Makarevich, Y. and Staring, M. and Ginat, D.T.},
  title =     {Artificial Intelligence for Head and Neck Anatomy and Lesion Segmentation},
  booktitle = {Artificial Intelligence in Neuroradiology},
  editor =    {Ginat, D.T.},
  publisher = {Springer},
  series =    {},
  chapter =   {},
  pages =     {181 -- 212},
  year =      {2026},
  pdf =       {},
  html =      {https://doi.org/10.1007/978-3-032-24568-7_3},
  abstract =  {Head and neck imaging plays a pivotal role in diagnosing cancer, planning treatments, and monitoring outcomes. In these tasks, accurate delineation (segmentation) of anatomical structures and lesions is critical. Radiotherapy treatment planning, for example, requires precise contouring of organs-at-risk (OARs) and target tumors to ensure adequate tumor dose while sparing healthy tissues. Traditionally, this contouring has been performed manually by radiologists or radiation oncologists - a time-consuming but indispensable process. For complex head and neck cases, manual delineation of the many small structures can take several hours for a single patient, even when focusing on a limited set of OARs. Indeed, modern guidelines recommend contouring over 40 distinct head and neck OARs for comprehensive care, a task that can exceed 3h of expert work for about two dozen structures. This extensive manual effort, combined with the intricate anatomy of the head and neck region, often leads to significant inter-observer variability - different experts may produce inconsistent contours despite following the same guidelines. Such inconsistencies can impact treatment quality and outcomes. Worse disease control and increased toxicity have been attributed to poor or inconsistent contouring in head and neck cancer care, underscoring the need for improvement.},
}

@incollection{deVos:2024,
  abbr =    {},
  bibtex_show = {true},
  author =    {de Vos, Bob D. and Sokooti, Hessam and Staring, Marius and I{\v{s}}gum, Ivana},
  title =     {Chapter 19 - Machine learning in image registration},
  booktitle = {Medical Image Analysis},
  editor =    {Frangi, Alejandro F. and Prince, Jerry L. and Sonka, Milan},
  publisher = {Academic Press},
  series =    {The MICCAI Society book Series},
  chapter =   {19},
  pages =     {501 -- 515},
  year =      {2024},
  pdf =       {},
  html =      {https://doi.org/10.1016/B978-0-12-813657-7.00031-5},
  abstract =  {Image registration, the task of aligning images, has been one of the key methods in medical image analysis. The goal in image registration is to find a coordinate mapping between a fixed target image and a moving source image. Until recently, machine learning was mainly used to aid image registration, e.g., for detecting misalignment. Nowadays, machine learning methods perform image registration themselves. In particular, deep learning-based image registration methods are gradually taking over the slow old methods. The benefit of machine learning-based image registration is that the spatial statistical relation between images are learned in an offline training phase. This means that during online inference time, image registration is performed very rapidly in one shot. In this chapter we will explain how tow train global and local image registration methods with supervised and unsupervised machine learning.},
}

